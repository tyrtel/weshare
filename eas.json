{
  "cli": {
    "version": ">= 12.0.0",
    "requireCommit": true,
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SIMULATE": "true",
        "EXPO_PUBLIC_QA_UNLOCK": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "debug-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SIMULATE": "false",
        "EXPO_PUBLIC_QA_UNLOCK": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SIMULATE": "false",
        "EXPO_PUBLIC_QA_UNLOCK": "true"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SIMULATE": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountKey.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountKey.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "open": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountKey.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
